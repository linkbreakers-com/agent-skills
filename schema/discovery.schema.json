{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/linkbreakers-com/agent-skills/main/schema/discovery.schema.json",
  "title": "Linkbreakers agent discovery index",
  "description": "Machine-readable index of every surface Linkbreakers exposes to AI agents. Read at runtime by linkbreakers.com.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "organization", "mcpServers", "apis", "cli", "sdks", "docs", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "logo", "description", "contactEmail", "sameAs"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "logo": { "$ref": "#/$defs/httpsUrl" },
        "description": { "type": "string", "minLength": 1 },
        "categories": {
          "description": "Directory categories, most specific first, for catalogs and agent-readiness scanners that classify sites (e.g. Infrastructure, Developer Tools).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "description": "Lowercase, hyphenated keywords for filtering and faceting.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "contactEmail": { "type": "string", "format": "email" },
        "sameAs": { "type": "array", "items": { "$ref": "#/$defs/httpsUrl" }, "uniqueItems": true },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["streetAddress", "addressLocality", "postalCode", "addressCountry"],
          "properties": {
            "streetAddress": { "type": "string", "minLength": 1 },
            "addressLocality": { "type": "string", "minLength": 1 },
            "addressRegion": { "type": "string", "minLength": 1 },
            "postalCode": { "type": "string", "minLength": 1 },
            "addressCountry": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "mcpServers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "title", "description", "url", "transport", "auth", "serverCardUrl", "docsUrl"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "name": { "type": "string", "pattern": "^[a-z0-9.-]+/[a-z0-9._-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1, "maxLength": 100 },
          "url": { "$ref": "#/$defs/httpsUrl" },
          "transport": { "enum": ["streamable-http", "sse", "stdio"] },
          "auth": { "enum": ["oauth2", "bearer", "none"] },
          "serverCardUrl": { "$ref": "#/$defs/httpsUrl" },
          "registryUrl": { "$ref": "#/$defs/httpsUrl" },
          "docsUrl": { "$ref": "#/$defs/httpsUrl" },
          "packages": {
            "description": "Packages that run this server locally over stdio, for clients that cannot connect to a remote server.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["registry", "package", "transport", "command", "registryUrl"],
              "properties": {
                "registry": { "enum": ["npm"] },
                "package": { "type": "string", "minLength": 1 },
                "transport": { "const": "stdio" },
                "command": { "type": "string", "minLength": 1 },
                "registryUrl": { "$ref": "#/$defs/httpsUrl" },
                "repo": { "$ref": "#/$defs/httpsUrl" }
              }
            }
          },
          "ui": {
            "description": "MCP Apps (io.modelcontextprotocol/ui): the ui:// views the server renders for tool results.",
            "type": "object",
            "additionalProperties": false,
            "required": ["extension", "mimeType", "docsUrl", "views"],
            "properties": {
              "extension": { "const": "io.modelcontextprotocol/ui" },
              "mimeType": { "type": "string", "minLength": 1 },
              "docsUrl": { "$ref": "#/$defs/httpsUrl" },
              "views": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["uri", "title", "tools"],
                  "properties": {
                    "uri": { "type": "string", "pattern": "^ui://" },
                    "title": { "type": "string", "minLength": 1 },
                    "tools": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "apis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "baseUrl", "openapiUrl", "docsUrl", "authDocsUrl"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "baseUrl": { "$ref": "#/$defs/httpsUrl" },
          "openapiUrl": { "$ref": "#/$defs/httpsUrl" },
          "docsUrl": { "$ref": "#/$defs/httpsUrl" },
          "authDocsUrl": { "$ref": "#/$defs/httpsUrl" },
          "protectedResourceMetadataUrl": { "$ref": "#/$defs/httpsUrl" }
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repo", "docsUrl", "install"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repo": { "$ref": "#/$defs/httpsUrl" },
        "docsUrl": { "$ref": "#/$defs/httpsUrl" },
        "install": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 },
          "properties": {
            "homebrew": { "type": "string" },
            "npm": { "type": "string" },
            "script": { "type": "string" }
          }
        },
        "registryUrls": {
          "type": "object",
          "description": "Registry page of each install method, keyed like install.",
          "additionalProperties": { "$ref": "#/$defs/httpsUrl" }
        }
      }
    },
    "sdks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "package", "registry", "repo"],
        "properties": {
          "language": { "enum": ["typescript", "python", "go", "java", "rust"] },
          "package": { "type": "string", "minLength": 1 },
          "registry": { "enum": ["npm", "pypi", "go", "maven", "crates"] },
          "registryUrl": { "$ref": "#/$defs/httpsUrl" },
          "install": { "type": "string", "minLength": 1 },
          "repo": { "$ref": "#/$defs/httpsUrl" },
          "docsUrl": { "$ref": "#/$defs/httpsUrl" }
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["llmsTxt", "llmsFullTxt", "helpCenter"],
      "properties": {
        "llmsTxt": { "$ref": "#/$defs/httpsUrl" },
        "llmsFullTxt": { "oneOf": [{ "$ref": "#/$defs/httpsUrl" }, { "type": "null" }] },
        "helpCenter": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "sandbox": {
      "description": "A test mode with its own credentials, separate from live data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "createEndpoint", "listEndpoint", "tokenPrefix", "lifetimeDays", "maxPerWorkspace", "billed", "monthlyLimits", "docsUrl"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "createEndpoint": { "$ref": "#/$defs/httpsUrl" },
        "listEndpoint": { "$ref": "#/$defs/httpsUrl" },
        "tokenPrefix": { "type": "string", "minLength": 1 },
        "lifetimeDays": { "type": "integer", "minimum": 1 },
        "maxPerWorkspace": { "type": "integer", "minimum": 1 },
        "billed": { "type": "boolean" },
        "monthlyLimits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiCalls", "countedScans", "links"],
          "properties": {
            "apiCalls": { "type": "integer", "minimum": 0 },
            "countedScans": { "type": "integer", "minimum": 0 },
            "links": { "type": "integer", "minimum": 0 }
          }
        },
        "docsUrl": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "path"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "path": { "type": "string", "pattern": "^skills/[a-z0-9]+(-[a-z0-9]+)*/SKILL\\.md$" }
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
