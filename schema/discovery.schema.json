{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/linkbreakers-com/agent-skills/main/schema/discovery.schema.json",
  "title": "Linkbreakers agent discovery index",
  "description": "Machine-readable index of every surface Linkbreakers exposes to AI agents. Read at runtime by linkbreakers.com.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "organization", "mcpServers", "apis", "cli", "sdks", "docs", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "logo", "description", "contactEmail", "sameAs"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "logo": { "$ref": "#/$defs/httpsUrl" },
        "description": { "type": "string", "minLength": 1 },
        "contactEmail": { "type": "string", "format": "email" },
        "sameAs": { "type": "array", "items": { "$ref": "#/$defs/httpsUrl" }, "uniqueItems": true }
      }
    },
    "mcpServers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "title", "description", "url", "transport", "auth", "serverCardUrl", "docsUrl"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "name": { "type": "string", "pattern": "^[a-z0-9.-]+/[a-z0-9._-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1, "maxLength": 100 },
          "url": { "$ref": "#/$defs/httpsUrl" },
          "transport": { "enum": ["streamable-http", "sse", "stdio"] },
          "auth": { "enum": ["oauth2", "bearer", "none"] },
          "serverCardUrl": { "$ref": "#/$defs/httpsUrl" },
          "registryUrl": { "$ref": "#/$defs/httpsUrl" },
          "docsUrl": { "$ref": "#/$defs/httpsUrl" }
        }
      }
    },
    "apis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "baseUrl", "openapiUrl", "docsUrl", "authDocsUrl"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "baseUrl": { "$ref": "#/$defs/httpsUrl" },
          "openapiUrl": { "$ref": "#/$defs/httpsUrl" },
          "docsUrl": { "$ref": "#/$defs/httpsUrl" },
          "authDocsUrl": { "$ref": "#/$defs/httpsUrl" },
          "protectedResourceMetadataUrl": { "$ref": "#/$defs/httpsUrl" }
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repo", "docsUrl", "install"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repo": { "$ref": "#/$defs/httpsUrl" },
        "docsUrl": { "$ref": "#/$defs/httpsUrl" },
        "install": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 },
          "properties": {
            "homebrew": { "type": "string" },
            "npm": { "type": "string" },
            "script": { "type": "string" }
          }
        }
      }
    },
    "sdks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "package", "registry", "repo"],
        "properties": {
          "language": { "enum": ["typescript", "python", "go", "java", "rust"] },
          "package": { "type": "string", "minLength": 1 },
          "registry": { "enum": ["npm", "pypi", "go", "maven", "crates"] },
          "registryUrl": { "$ref": "#/$defs/httpsUrl" },
          "install": { "type": "string", "minLength": 1 },
          "repo": { "$ref": "#/$defs/httpsUrl" },
          "docsUrl": { "$ref": "#/$defs/httpsUrl" }
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["llmsTxt", "llmsFullTxt", "helpCenter"],
      "properties": {
        "llmsTxt": { "$ref": "#/$defs/httpsUrl" },
        "llmsFullTxt": { "oneOf": [{ "$ref": "#/$defs/httpsUrl" }, { "type": "null" }] },
        "helpCenter": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "path"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "path": { "type": "string", "pattern": "^skills/[a-z0-9]+(-[a-z0-9]+)*/SKILL\\.md$" }
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
